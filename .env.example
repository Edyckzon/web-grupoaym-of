# Public URL only; never put an email provider secret in VITE_* variables.
# POST JSON endpoint; returns 2xx only after the message is accepted.
# Expected fields: name, company, email, phone, brand, message, consent.
# Routing to each recipient belongs to the server, not the browser.
VITE_CONTACT_ENDPOINT=
# Link to the approved privacy document before enabling the form.
VITE_PRIVACY_URL=
